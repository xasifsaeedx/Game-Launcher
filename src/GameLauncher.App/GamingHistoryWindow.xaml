<Window x:Class="GameLauncher.App.GamingHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gaming History"
        Width="1060"
        Height="680"
        MinWidth="880"
        MinHeight="540"
        WindowStartupLocation="CenterOwner"
        Background="#0E1014"
        Foreground="#F5F7FA">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="PHASE 7 · HISTORY + CONSOLE ACCOUNTS" FontSize="11" FontWeight="SemiBold" Foreground="#8EA8FF"/>
                <TextBlock Text="Gaming History" Margin="0,3,0,0" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock Text="Account snapshots and launcher tracking stay separate to avoid double counting."
                           Margin="0,5,0,0" Foreground="#9EA6B2"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Content="Steam setup" Margin="0,0,8,0" Click="SteamSetup_Click"/>
                <Button Content="Sync Steam" Click="SyncSteam_Click"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Background="#181B21" CornerRadius="10" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Import source" VerticalAlignment="Center" Foreground="#9EA6B2"/>
                <ComboBox x:Name="ImportSourceComboBox" Grid.Column="1" Margin="8,0,0,0" Padding="6"/>
                <Button Grid.Column="3" Content="Import account file..." Click="ImportFile_Click"/>
                <TextBlock Grid.Column="4"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="#7E8794"
                           Text="PlayStation: official .xlsx Data Access export · Others: CSV/JSON"
                           TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Border>

        <DataGrid x:Name="HistoryGrid"
                  Grid.Row="4"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  Background="#101319"
                  Foreground="#F5F7FA"
                  RowBackground="#101319"
                  AlternatingRowBackground="#141820"
                  BorderBrush="#343A46"
                  GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Game" Binding="{Binding Title}" Width="*"/>
                <DataGridTextColumn Header="Sources" Binding="{Binding Sources}" Width="170"/>
                <DataGridTextColumn Header="Account playtime" Binding="{Binding AccountPlaytime}" Width="110"/>
                <DataGridTextColumn Header="Launcher tracked" Binding="{Binding LauncherPlaytime}" Width="105"/>
                <DataGridTextColumn Header="Last played" Binding="{Binding LastPlayed}" Width="95"/>
                <DataGridTextColumn Header="" Binding="{Binding Installed}" Width="75"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="StatusText" Grid.Row="6" Foreground="#9EA6B2" TextWrapping="Wrap"/>
    </Grid>
</Window>

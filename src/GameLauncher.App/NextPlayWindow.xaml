<Window x:Class="GameLauncher.App.NextPlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Next Play"
        Width="1000"
        Height="680"
        MinWidth="850"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="#0E1014"
        Foreground="#F5F7FA">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="HATCHABLE · MY NEXT 100" FontSize="11" FontWeight="SemiBold" Foreground="#8EA8FF"/>
                <TextBlock Text="Next Play" Margin="0,3,0,0" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock Text="Website ranking with local install/playtime state."
                           Margin="0,5,0,0" Foreground="#9EA6B2"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Sync now" VerticalAlignment="Bottom" Click="Sync_Click"/>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <DataGrid x:Name="GamesGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionChanged="GamesGrid_SelectionChanged"
                      Background="#101319"
                      Foreground="#F5F7FA"
                      RowBackground="#101319"
                      AlternatingRowBackground="#141820"
                      BorderBrush="#343A46"
                      GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Rank}" Width="42"/>
                    <DataGridTextColumn Header="Game" Binding="{Binding Title}" Width="*"/>
                    <DataGridTextColumn Header="Platforms" Binding="{Binding Platforms}" Width="115"/>
                    <DataGridTextColumn Header="Preference" Binding="{Binding LibraryStatus}" Width="90"/>
                    <DataGridTextColumn Header="Progress" Binding="{Binding Progress}" Width="82"/>
                    <DataGridTextColumn Header="Rating" Binding="{Binding Rating}" Width="58"/>
                    <DataGridTextColumn Header="Playtime" Binding="{Binding Playtime}" Width="70"/>
                    <DataGridTextColumn Header="" Binding="{Binding Installed}" Width="70"/>
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Column="2" Background="#181B21" CornerRadius="10" Padding="16">
                <StackPanel>
                    <TextBlock Text="Selected game" Foreground="#8E96A3"/>
                    <TextBlock x:Name="SelectedTitleText" Margin="0,4,0,16" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="Progress" Foreground="#8E96A3" Margin="0,0,0,5"/>
                    <ComboBox x:Name="ProgressComboBox"
                              Padding="7"
                              DisplayMemberPath="Label"
                              SelectedValuePath="Value"/>
                    <TextBlock Text="Rating" Foreground="#8E96A3" Margin="0,14,0,5"/>
                    <ComboBox x:Name="RatingComboBox"
                              Padding="7"
                              DisplayMemberPath="Label"
                              SelectedValuePath="Value"/>
                    <Button Content="Save progress" Margin="0,16,0,0" FontWeight="SemiBold" Click="SaveProgress_Click"/>
                    <TextBlock x:Name="SelectionStatusText" Margin="0,12,0,0" Foreground="#9EA6B2" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="4" Foreground="#9EA6B2"/>
    </Grid>
</Window>

<Window x:Class="GameLauncher.App.NextPlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Personal Library"
        Width="1050"
        Height="700"
        MinWidth="900"
        MinHeight="580"
        WindowStartupLocation="CenterOwner"
        Background="#0D1117"
        Foreground="#F7F9FC">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="PERSONAL GAME LIBRARY" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                <TextBlock Text="Next Play" Margin="0,4,0,0" FontSize="30" FontWeight="SemiBold"/>
                <TextBlock Text="Your Google Sheets ranking with local install state and launcher ratings."
                           Margin="0,6,0,0" Foreground="{StaticResource MutedTextBrush}"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Refresh sheet" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Bottom" Click="Sync_Click"/>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="290"/>
            </Grid.ColumnDefinitions>

            <DataGrid x:Name="GamesGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionChanged="GamesGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding RankText}" Width="45"/>
                    <DataGridTextColumn Header="Game" Binding="{Binding Title}" Width="*"/>
                    <DataGridTextColumn Header="Platforms" Binding="{Binding Platforms}" Width="120"/>
                    <DataGridTextColumn Header="Preference" Binding="{Binding LibraryStatus}" Width="95"/>
                    <DataGridTextColumn Header="Progress" Binding="{Binding Progress}" Width="88"/>
                    <DataGridTextColumn Header="Rating" Binding="{Binding Rating}" Width="68"/>
                    <DataGridTextColumn Header="" Binding="{Binding Installed}" Width="74"/>
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="18">
                <StackPanel>
                    <TextBlock Text="SELECTED GAME" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock x:Name="SelectedTitleText" Margin="0,5,0,18" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="Launcher rating" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <ComboBox x:Name="RatingComboBox"
                              Padding="8"
                              DisplayMemberPath="Label"
                              SelectedValuePath="Value"/>
                    <Button Content="Save rating"
                            Margin="0,14,0,0"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="SaveRating_Click"/>
                    <TextBlock x:Name="SelectionStatusText"
                               Margin="0,14,0,0"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap"/>
                    <Separator Margin="0,18,0,14"/>
                    <TextBlock Text="Sheet fields such as rank, status and progress are read-only here. Edit those directly in Google Sheets."
                               FontSize="11"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="4" Foreground="{StaticResource MutedTextBrush}"/>
    </Grid>
</Window>

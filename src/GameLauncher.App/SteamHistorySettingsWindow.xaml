<Window x:Class="GameLauncher.App.SteamHistorySettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Steam History"
        Width="580"
        Height="450"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#0E1014"
        Foreground="#F5F7FA">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="PHASE 7 · STEAM HISTORY" FontSize="11" FontWeight="SemiBold" Foreground="#8EA8FF"/>
            <TextBlock Text="Connect Steam library history" Margin="0,3,0,0" FontSize="25" FontWeight="SemiBold"/>
            <TextBlock Text="Uses Valve's read-only GetOwnedGames Web API. Your password is never requested."
                       Margin="0,5,0,0" Foreground="#9EA6B2" TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="2" Background="#181B21" CornerRadius="10" Padding="16">
            <StackPanel>
                <TextBlock Text="SteamID64" Foreground="#9EA6B2" Margin="0,0,0,5"/>
                <TextBox x:Name="SteamIdTextBox" Padding="8"/>
                <TextBlock Text="Steam Web API key" Foreground="#9EA6B2" Margin="0,12,0,5"/>
                <PasswordBox x:Name="ApiKeyPasswordBox" Padding="8"/>
                <CheckBox x:Name="AutoSyncCheckBox"
                          Content="Automatically refresh Steam history when the launcher starts"
                          Margin="0,14,0,0"/>
                <Button Content="Open Valve API-key page"
                        Margin="0,12,0,0"
                        HorizontalAlignment="Left"
                        Click="OpenApiKeyPage_Click"/>
            </StackPanel>
        </Border>

        <TextBlock x:Name="StatusText" Grid.Row="3" Margin="0,14,0,0"
                   Foreground="#9EA6B2" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Disconnect" Margin="0,0,8,0" Click="Disconnect_Click"/>
            <Button Content="Save &amp; test" FontWeight="SemiBold" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>

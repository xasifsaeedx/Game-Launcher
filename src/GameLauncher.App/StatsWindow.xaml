<Window x:Class="GameLauncher.App.StatsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Launcher Stats"
        Width="720"
        Height="500"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#0E1014"
        Foreground="#F5F7FA">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="MY GAME LAUNCHER" FontSize="11" FontWeight="SemiBold" Foreground="#8EA8FF"/>
            <TextBlock Text="Stats" Margin="0,3,0,0" FontSize="30" FontWeight="SemiBold"/>
            <TextBlock Text="Launcher tracking and imported account history are reported separately."
                       Margin="0,5,0,0" Foreground="#9EA6B2"/>
        </StackPanel>

        <UniformGrid Grid.Row="2" Rows="3" Columns="2">
            <Border Margin="0,0,8,8" Padding="16" Background="#181B21" CornerRadius="10">
                <StackPanel><TextBlock Text="INSTALLED" Foreground="#8E96A3"/><TextBlock x:Name="InstalledText" FontSize="28" FontWeight="SemiBold"/></StackPanel>
            </Border>
            <Border Margin="8,0,0,8" Padding="16" Background="#181B21" CornerRadius="10">
                <StackPanel><TextBlock Text="FAVORITES" Foreground="#8E96A3"/><TextBlock x:Name="FavoritesText" FontSize="28" FontWeight="SemiBold"/></StackPanel>
            </Border>
            <Border Margin="0,8,8,8" Padding="16" Background="#181B21" CornerRadius="10">
                <StackPanel><TextBlock Text="LAUNCHER TRACKED" Foreground="#8E96A3"/><TextBlock x:Name="LauncherPlaytimeText" FontSize="24" FontWeight="SemiBold"/></StackPanel>
            </Border>
            <Border Margin="8,8,0,8" Padding="16" Background="#181B21" CornerRadius="10">
                <StackPanel><TextBlock Text="ACCOUNT HISTORY" Foreground="#8E96A3"/><TextBlock x:Name="AccountPlaytimeText" FontSize="24" FontWeight="SemiBold"/></StackPanel>
            </Border>
            <Border Margin="0,8,8,0" Padding="16" Background="#181B21" CornerRadius="10">
                <StackPanel><TextBlock Text="MOST PLAYED LOCALLY" Foreground="#8E96A3"/><TextBlock x:Name="MostPlayedText" Margin="0,4,0,0" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel>
            </Border>
            <Border Margin="8,8,0,0" Padding="16" Background="#181B21" CornerRadius="10">
                <StackPanel><TextBlock Text="RECENTLY PLAYED" Foreground="#8E96A3"/><TextBlock x:Name="RecentText" Margin="0,4,0,0" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel>
            </Border>
        </UniformGrid>

        <TextBlock x:Name="FooterText" Grid.Row="3" Margin="0,16,0,0" Foreground="#9EA6B2"/>
    </Grid>
</Window>

<Window x:Class="GameLauncher.App.RateGameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rate game"
        Width="420"
        Height="265"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#0D1117"
        Foreground="#F7F9FC">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="YOUR RATING" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
            <TextBlock x:Name="GameTitleText" Margin="0,4,0,0" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="2" Padding="16" Background="{StaticResource SurfaceBrush}" CornerRadius="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="140"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Personal score" FontWeight="SemiBold"/>
                    <TextBlock Text="Saved locally in the launcher." Margin="0,4,0,0" FontSize="11" Foreground="{StaticResource MutedTextBrush}"/>
                </StackPanel>
                <ComboBox x:Name="RatingComboBox" Grid.Column="1" Padding="8"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="Save rating" Style="{StaticResource PrimaryButtonStyle}" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>

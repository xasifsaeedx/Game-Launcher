<Window x:Class="GameLauncher.App.AddGameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add game"
        Width="560"
        Height="410"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#111318"
        Foreground="#F5F7FA">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Add a manual game" FontSize="24" FontWeight="SemiBold"/>

        <StackPanel Grid.Row="2">
            <TextBlock Text="Game name" Foreground="#AEB5C0" Margin="0,0,0,5"/>
            <TextBox x:Name="TitleTextBox" Padding="9" Background="#1A1E25" Foreground="#F5F7FA" BorderBrush="#343A46"/>
        </StackPanel>

        <StackPanel Grid.Row="4">
            <TextBlock Text="Executable" Foreground="#AEB5C0" Margin="0,0,0,5"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ExecutableTextBox" Padding="9" Background="#1A1E25" Foreground="#F5F7FA" BorderBrush="#343A46"/>
                <Button Grid.Column="2" Content="Browse" Padding="14,8" Click="BrowseExecutable_Click"/>
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="6">
            <TextBlock Text="Cover image (optional)" Foreground="#AEB5C0" Margin="0,0,0,5"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="CoverTextBox" Padding="9" Background="#1A1E25" Foreground="#F5F7FA" BorderBrush="#343A46"/>
                <Button Grid.Column="2" Content="Browse" Padding="14,8" Click="BrowseCover_Click"/>
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="8">
            <TextBlock Text="Launch arguments (optional)" Foreground="#AEB5C0" Margin="0,0,0,5"/>
            <TextBox x:Name="ArgumentsTextBox" Padding="9" Background="#1A1E25" Foreground="#F5F7FA" BorderBrush="#343A46"/>
        </StackPanel>

        <StackPanel Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Padding="18,9" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="Add game" Padding="18,9" FontWeight="SemiBold" IsDefault="True" Click="Add_Click"/>
        </StackPanel>
    </Grid>
</Window>

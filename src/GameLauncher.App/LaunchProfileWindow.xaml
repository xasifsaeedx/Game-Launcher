<Window x:Class="GameLauncher.App.LaunchProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Launch Profiles"
        Width="1040"
        Height="650"
        MinWidth="900"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="#0E1014"
        Foreground="#F5F7FA">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="SMART LAUNCHING" FontSize="11" FontWeight="SemiBold" Foreground="#8E96A3"/>
            <TextBlock x:Name="HeadingText" Margin="0,3,0,0" FontSize="26" FontWeight="SemiBold"/>
            <TextBlock Text="Choose what starts before, alongside, and after the game."
                       Margin="0,5,0,0" Foreground="#9EA6B2"/>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#181B21" CornerRadius="10" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Profiles" FontWeight="SemiBold" FontSize="15"/>
                    <ListBox x:Name="ProfilesList"
                             Grid.Row="2"
                             Background="Transparent"
                             Foreground="#F5F7FA"
                             BorderThickness="0"
                             DisplayMemberPath="Name"
                             SelectionChanged="ProfilesList_SelectionChanged"/>

                    <StackPanel Grid.Row="4">
                        <Button Content="+ New profile" Margin="0,0,0,7" Click="NewProfile_Click"/>
                        <Button Content="Delete profile" Click="DeleteProfile_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="#181B21" CornerRadius="10" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Profile name" Foreground="#9EA6B2" Margin="0,0,0,5"/>
                            <TextBox x:Name="ProfileNameTextBox"
                                     Padding="8"
                                     Background="#101319"
                                     Foreground="#F5F7FA"
                                     BorderBrush="#343A46"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Game installation" Foreground="#9EA6B2" Margin="0,0,0,5"/>
                            <ComboBox x:Name="InstallationComboBox"
                                      Padding="7"
                                      DisplayMemberPath="Label"
                                      Background="#101319"
                                      Foreground="#111318"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="2">
                        <TextBlock Text="Game arguments override (optional)"
                                   Foreground="#9EA6B2"
                                   Margin="0,0,0,5"/>
                        <TextBox x:Name="GameArgumentsTextBox"
                                 Padding="8"
                                 Background="#101319"
                                 Foreground="#F5F7FA"
                                 BorderBrush="#343A46"/>
                    </StackPanel>

                    <Grid Grid.Row="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Actions" FontWeight="SemiBold" FontSize="15"/>
                                <TextBlock Text="Wait applies to Pre/Post. Close applies to Companion."
                                           FontSize="11" Foreground="#8E96A3" Margin="0,3,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="+ Pre" Margin="0,0,6,0" Tag="PreLaunch" Click="AddAction_Click"/>
                                <Button Content="+ Companion" Margin="0,0,6,0" Tag="Companion" Click="AddAction_Click"/>
                                <Button Content="+ Post" Tag="PostGame" Click="AddAction_Click"/>
                            </StackPanel>
                        </Grid>

                        <DataGrid x:Name="ActionsGrid"
                                  Grid.Row="2"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  Background="#101319"
                                  Foreground="#F5F7FA"
                                  RowBackground="#101319"
                                  AlternatingRowBackground="#141820"
                                  BorderBrush="#343A46">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Stage" Binding="{Binding Stage}" IsReadOnly="True" Width="90"/>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="115"/>
                                <DataGridTextColumn Header="Program" Binding="{Binding ExecutablePath}" Width="*"/>
                                <DataGridTextColumn Header="Arguments" Binding="{Binding Arguments}" Width="120"/>
                                <DataGridTextColumn Header="Working dir" Binding="{Binding WorkingDirectory}" Width="130"/>
                                <DataGridCheckBoxColumn Header="Wait" Binding="{Binding WaitForExit}" Width="50"/>
                                <DataGridCheckBoxColumn Header="Close" Binding="{Binding CloseWithGame}" Width="50"/>
                                <DataGridCheckBoxColumn Header="On" Binding="{Binding IsEnabled}" Width="42"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
                        <CheckBox x:Name="DefaultCheckBox"
                                  Content="Default one-click profile"
                                  VerticalAlignment="Center"
                                  Margin="0,0,18,0"/>
                        <Button Content="Save profile"
                                FontWeight="SemiBold"
                                Click="SaveProfile_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <TextBlock x:Name="StatusText"
                   Grid.Row="4"
                   VerticalAlignment="Center"
                   Foreground="#9EA6B2"
                   Text="Ready."/>
    </Grid>
</Window>

<Window x:Class="GameLauncher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="My Game Launcher"
        Width="1120"
        Height="720"
        MinWidth="800"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="#0E1014"
        Foreground="#F5F7FA">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="MY GAME LAUNCHER" FontSize="11" FontWeight="SemiBold" Foreground="#8E96A3"/>
                <TextBlock Text="Library" Margin="0,3,0,0" FontSize="30" FontWeight="SemiBold"/>
                <TextBlock x:Name="LibrarySummaryText" Margin="0,5,0,0" Foreground="#9EA6B2" Text="Loading library..."/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button x:Name="SyncSteamButton" Content="Sync Steam" Margin="0,0,8,0" Click="SyncSteamButton_Click"/>
                <Button Content="+ Add game" FontWeight="SemiBold" Click="AddGameButton_Click"/>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="GameGrid">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="190" Height="310" Margin="0,0,16,16" Padding="10"
                                Background="#181B21" CornerRadius="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="205"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Background="#242933" CornerRadius="7">
                                    <Grid>
                                        <TextBlock Text="NO COVER" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   FontSize="11" FontWeight="SemiBold" Foreground="#657080"/>
                                        <Image Source="{Binding CoverImagePath}" Stretch="UniformToFill"/>
                                    </Grid>
                                </Border>

                                <TextBlock Grid.Row="2" Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
                                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding Source}" FontSize="11" Foreground="#8E96A3"/>
                                    <TextBlock Text="  •  " FontSize="11" Foreground="#59616D"/>
                                    <TextBlock Text="{Binding Playtime}" FontSize="11" Foreground="#8E96A3"/>
                                </StackPanel>

                                <Button Grid.Row="5" Content="Play" Tag="{Binding GameId}" FontWeight="SemiBold"
                                        HorizontalAlignment="Stretch" Click="PlayButton_Click"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#9EA6B2" Text="Ready."/>
            <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="#59616D" Text="Phase 1"/>
        </Grid>
    </Grid>
</Window>

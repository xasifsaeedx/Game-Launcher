<Window x:Class="GameLauncher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="My Game Launcher"
        Width="1440"
        Height="820"
        MinWidth="1120"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#0E1014"
        Foreground="#F5F7FA">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="MY GAME LAUNCHER" FontSize="11" FontWeight="SemiBold" Foreground="#8EA8FF"/>
                <TextBlock Text="Unified Library" Margin="0,3,0,0" FontSize="31" FontWeight="SemiBold"/>
                <TextBlock x:Name="LibrarySummaryText"
                           Margin="0,5,0,0"
                           Foreground="#9EA6B2"
                           Text="Loading library..."/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Content="Controller" Margin="0,0,7,0" Click="ControllerButton_Click"/>
                <Button Content="Stats" Margin="0,0,7,0" Click="StatsButton_Click"/>
                <Button Content="History" Margin="0,0,7,0" Click="HistoryButton_Click"/>
                <Button Content="Graphics" Margin="0,0,7,0" Click="GraphicsButton_Click"/>
                <Button Content="Next Play" Margin="0,0,7,0" Click="NextPlayButton_Click"/>
                <Button Content="Hatchable" Margin="0,0,7,0" Click="HatchableButton_Click"/>
                <Button Content="Overlay" Margin="0,0,7,0" Click="OverlayButton_Click"/>
                <Button Content="Tools" Margin="0,0,7,0" Click="ToolsButton_Click"/>
                <Button x:Name="SyncLibraryButton" Content="Sync" Margin="0,0,7,0" Click="SyncLibraryButton_Click"/>
                <Button Content="+ Add" FontWeight="SemiBold" Click="AddGameButton_Click"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Background="#15191F" CornerRadius="10" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="180"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="SearchTextBox"
                         Padding="10,8"
                         FontSize="14"
                         Background="#0F1217"
                         Foreground="#F5F7FA"
                         BorderBrush="#343A46"
                         TextChanged="SearchTextBox_TextChanged">
                    <TextBox.ToolTip>Search by title, platform, or store</TextBox.ToolTip>
                </TextBox>

                <ComboBox x:Name="FilterComboBox"
                          Grid.Column="2"
                          Padding="8"
                          DisplayMemberPath="Label"
                          SelectionChanged="FilterComboBox_SelectionChanged"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="4"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="GameGrid">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="194"
                                Height="350"
                                Margin="0,0,16,16"
                                Padding="10"
                                Background="#181B21"
                                BorderBrush="#262D36"
                                BorderThickness="1"
                                CornerRadius="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="205"/>
                                    <RowDefinition Height="9"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Background="#242933" CornerRadius="7">
                                    <Grid>
                                        <TextBlock Text="NO COVER"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="#657080"/>
                                        <Image Source="{Binding CoverImagePath}" Stretch="UniformToFill"/>

                                        <Border HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Margin="7"
                                                Padding="6,3"
                                                CornerRadius="5"
                                                Background="#D9192029">
                                            <TextBlock Text="{Binding RankBadge}"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       Foreground="#AFC0FF"/>
                                        </Border>

                                        <Button HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Margin="7"
                                                Padding="7,3"
                                                Tag="{Binding GameId}"
                                                Content="{Binding FavoriteGlyph}"
                                                FontSize="17"
                                                Foreground="#F4C542"
                                                Background="#D9192029"
                                                BorderThickness="0"
                                                Click="FavoriteButton_Click"/>
                                    </Grid>
                                </Border>

                                <TextBlock Grid.Row="2"
                                           Text="{Binding Title}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Title}"/>

                                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding Source}"
                                               FontSize="11"
                                               Foreground="#8E96A3"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="105"/>
                                    <TextBlock Text="  •  " FontSize="11" Foreground="#59616D"/>
                                    <TextBlock Text="{Binding Playtime}" FontSize="11" Foreground="#8E96A3"/>
                                </StackPanel>

                                <TextBlock Grid.Row="4"
                                           Text="{Binding SyncState}"
                                           Margin="0,3,0,0"
                                           FontSize="11"
                                           Foreground="#8EA8FF"/>

                                <Grid Grid.Row="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="7"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Content="Play"
                                            Tag="{Binding GameId}"
                                            FontWeight="SemiBold"
                                            HorizontalAlignment="Stretch"
                                            Click="PlayButton_Click"/>
                                    <Button Grid.Column="2"
                                            Content="Profiles"
                                            Tag="{Binding GameId}"
                                            Padding="10,8"
                                            Click="ProfilesButton_Click"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText"
                       VerticalAlignment="Center"
                       Foreground="#9EA6B2"
                       Text="Ready."/>
            <TextBlock Grid.Column="1"
                       VerticalAlignment="Center"
                       Foreground="#59616D"
                       Text="v1.0 · Phase 8"/>
        </Grid>
    </Grid>
</Window>

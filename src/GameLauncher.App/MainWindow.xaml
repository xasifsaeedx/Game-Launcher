<Window x:Class="GameLauncher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="My Game Launcher"
        Icon="Assets/GameLauncher.ico"
        Width="1440"
        Height="840"
        MinWidth="1120"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="#0D1117"
        Foreground="#F7F9FC">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Width="62" Height="62" CornerRadius="16" Background="{StaticResource SurfaceRaisedBrush}">
                <Image Source="Assets/GameLauncher.ico" Margin="8" Stretch="Uniform"/>
            </Border>

            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock Text="MY GAME LAUNCHER" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                <TextBlock Text="Unified Library" Margin="0,3,0,0" FontSize="31" FontWeight="SemiBold"/>
                <TextBlock x:Name="LibrarySummaryText"
                           Margin="0,5,0,0"
                           Foreground="{StaticResource MutedTextBrush}"
                           Text="Loading library..."/>
            </StackPanel>

            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="SyncLibraryButton"
                        Content="Refresh"
                        Margin="0,0,8,0"
                        Click="SyncLibraryButton_Click"/>
                <Button Content="+ Add game"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="AddGameButton_Click"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="10">
            <StackPanel Orientation="Horizontal">
                <Button Content="Controller" Margin="0,0,7,0" Click="ControllerButton_Click"/>
                <Button Content="Stats" Margin="0,0,7,0" Click="StatsButton_Click"/>
                <Button Content="History" Margin="0,0,7,0" Click="HistoryButton_Click"/>
                <Button Content="Graphics" Margin="0,0,7,0" Click="GraphicsButton_Click"/>
                <Button Content="Next Play" Margin="0,0,7,0" Click="NextPlayButton_Click"/>
                <Button Content="Personal Library" Margin="0,0,7,0" Click="PersonalLibraryButton_Click"/>
                <Button Content="Overlay" Margin="0,0,7,0" Click="OverlayButton_Click"/>
                <Button Content="Tools" Click="ToolsButton_Click"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="4"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="190"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="SearchTextBox"
                         Padding="11,9"
                         FontSize="14"
                         TextChanged="SearchTextBox_TextChanged">
                    <TextBox.ToolTip>Search by title, platform, or store</TextBox.ToolTip>
                </TextBox>

                <ComboBox x:Name="FilterComboBox"
                          Grid.Column="2"
                          Padding="9"
                          DisplayMemberPath="Label"
                          SelectionChanged="FilterComboBox_SelectionChanged"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="6"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="GameGrid">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="210"
                                Height="370"
                                Margin="0,0,16,16"
                                Padding="11"
                                CornerRadius="13">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="216"/>
                                    <RowDefinition Height="9"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Background="#242C39" CornerRadius="9" ClipToBounds="True">
                                    <Grid>
                                        <TextBlock Text="NO COVER"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource SubtleTextBrush}"/>
                                        <Image Source="{Binding CoverImagePath}" Stretch="UniformToFill"/>

                                        <Border HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Margin="8"
                                                Padding="7,4"
                                                CornerRadius="6"
                                                Background="#DD141A24">
                                            <TextBlock Text="{Binding RankBadge}"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       Foreground="#C5D1FF"/>
                                        </Border>

                                        <Button HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Margin="8"
                                                Padding="7,3"
                                                MinHeight="0"
                                                Tag="{Binding GameId}"
                                                Content="{Binding FavoriteGlyph}"
                                                FontSize="18"
                                                Foreground="#F4C542"
                                                Background="#DD141A24"
                                                BorderThickness="0"
                                                Click="FavoriteButton_Click"/>
                                    </Grid>
                                </Border>

                                <TextBlock Grid.Row="2"
                                           Text="{Binding Title}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Title}"/>

                                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,5,0,0">
                                    <TextBlock Text="{Binding Source}"
                                               FontSize="11"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="112"/>
                                    <TextBlock Text="  •  " FontSize="11" Foreground="{StaticResource SubtleTextBrush}"/>
                                    <TextBlock Text="{Binding Playtime}" FontSize="11" Foreground="{StaticResource MutedTextBrush}"/>
                                </StackPanel>

                                <Grid Grid.Row="4" Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding SyncState}"
                                               FontSize="11"
                                               Foreground="{StaticResource AccentBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Button Grid.Column="1"
                                            Content="{Binding RatingText}"
                                            Tag="{Binding GameId}"
                                            Padding="7,2"
                                            MinHeight="24"
                                            FontSize="11"
                                            Click="RateButton_Click"/>
                                </Grid>

                                <Grid Grid.Row="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="7"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Content="Play"
                                            Tag="{Binding GameId}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            HorizontalAlignment="Stretch"
                                            Click="PlayButton_Click"/>
                                    <Button Grid.Column="2"
                                            Content="Profiles"
                                            Tag="{Binding GameId}"
                                            Padding="10,8"
                                            Click="ProfilesButton_Click"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Grid Grid.Row="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource MutedTextBrush}"
                       Text="Ready."/>
            <TextBlock Grid.Column="1"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource SubtleTextBrush}"
                       Text="v1.1"/>
        </Grid>
    </Grid>
</Window>

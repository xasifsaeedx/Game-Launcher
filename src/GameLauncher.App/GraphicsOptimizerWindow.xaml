<Window x:Class="GameLauncher.App.GraphicsOptimizerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Graphics Optimizer"
        Width="1080"
        Height="720"
        MinWidth="940"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="#0E1014"
        Foreground="#F5F7FA">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="PHASE 6 · GRAPHICS OPTIMIZER" FontSize="11" FontWeight="SemiBold" Foreground="#8EA8FF"/>
                <TextBlock Text="1080p / 60 FPS / quality target" Margin="0,3,0,0" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock x:Name="HardwareSummaryText" Margin="0,5,0,0" Foreground="#9EA6B2" Text="Detecting hardware..."/>
            </StackPanel>
            <Button Grid.Column="1" Content="Detect again" VerticalAlignment="Bottom" Click="DetectAgain_Click"/>
        </Grid>

        <Border Grid.Row="2" Background="#181B21" CornerRadius="10" Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="78"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="78"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Width" VerticalAlignment="Center" Foreground="#9EA6B2"/>
                <TextBox x:Name="WidthTextBox" Grid.Column="1" Margin="7,0,0,0" Padding="7"/>
                <TextBlock Grid.Column="3" Text="Height" VerticalAlignment="Center" Foreground="#9EA6B2"/>
                <TextBox x:Name="HeightTextBox" Grid.Column="4" Margin="7,0,0,0" Padding="7"/>
                <TextBlock Grid.Column="6" Text="FPS" VerticalAlignment="Center" Foreground="#9EA6B2"/>
                <TextBox x:Name="FpsTextBox" Grid.Column="7" Margin="7,0,0,0" Padding="7"/>
                <TextBlock Grid.Column="9" Text="Preference" VerticalAlignment="Center" Foreground="#9EA6B2"/>
                <ComboBox x:Name="PreferenceComboBox" Grid.Column="10" Margin="7,0,0,0" Padding="6"/>
                <TextBlock Grid.Column="12" Text="GPU tier" VerticalAlignment="Center" Foreground="#9EA6B2"/>
                <ComboBox x:Name="TierComboBox" Grid.Column="13" Margin="7,0,0,0" Padding="6" DisplayMemberPath="Label"/>
                <Button Grid.Column="15" Content="Save target" Margin="14,0,0,0" FontWeight="SemiBold" Click="SaveTarget_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="370"/>
            </Grid.ColumnDefinitions>

            <DataGrid x:Name="GamesGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionChanged="GamesGrid_SelectionChanged"
                      Background="#101319"
                      Foreground="#F5F7FA"
                      RowBackground="#101319"
                      AlternatingRowBackground="#141820"
                      BorderBrush="#343A46"
                      GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Game" Binding="{Binding Title}" Width="*"/>
                    <DataGridTextColumn Header="Preset" Binding="{Binding Preset}" Width="85"/>
                    <DataGridTextColumn Header="Support" Binding="{Binding Support}" Width="110"/>
                    <DataGridTextColumn Header="Safe fields" Binding="{Binding SafeChanges}" Width="72"/>
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Column="2" Background="#181B21" CornerRadius="10" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="SELECTED GAME" FontSize="10" FontWeight="Bold" Foreground="#8EA8FF"/>
                        <TextBlock x:Name="SelectedTitleText" Margin="0,4,0,3" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="SelectedSupportText" Foreground="#9EA6B2" TextWrapping="Wrap"/>
                    </StackPanel>

                    <Border Grid.Row="1" Margin="0,12,0,12" Padding="10" Background="#101319" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="SAFE AUTOMATIC CHANGES" FontSize="10" FontWeight="Bold" Foreground="#9EA6B2"/>
                            <TextBlock x:Name="SafeChangesText" Margin="0,5,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="RecommendationsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="#D8DDE5"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel Grid.Row="3">
                        <CheckBox x:Name="AutoApplyCheckBox"
                                  Content="Automatically apply verified safe fields before launch"
                                  Margin="0,10,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="ApplyButton" Content="Apply safe settings" FontWeight="SemiBold" Click="Apply_Click"/>
                            <Button Grid.Column="2" Content="Restore original" Click="Restore_Click"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="6" Foreground="#9EA6B2" TextWrapping="Wrap"/>
    </Grid>
</Window>

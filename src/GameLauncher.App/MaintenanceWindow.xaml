<Window x:Class="GameLauncher.App.MaintenanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Maintenance"
        Width="660"
        Height="520"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#0E1014"
        Foreground="#F5F7FA">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="MY GAME LAUNCHER" FontSize="11" FontWeight="SemiBold" Foreground="#8EA8FF"/>
            <TextBlock Text="Backup, export &amp; updates" Margin="0,3,0,0" FontSize="27" FontWeight="SemiBold"/>
            <TextBlock x:Name="VersionText" Margin="0,5,0,0" Foreground="#9EA6B2"/>
        </StackPanel>

        <Border Grid.Row="2" Padding="16" Background="#181B21" CornerRadius="10">
            <StackPanel>
                <TextBlock Text="YOUR DATA" FontSize="11" FontWeight="Bold" Foreground="#9EA6B2"/>
                <TextBlock Text="Create a full ZIP backup of local launcher data, or export the merged Gaming History as CSV."
                           Margin="0,5,0,12" TextWrapping="Wrap" Foreground="#D9DEE5"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Create backup ZIP" Margin="0,0,8,0" Click="Backup_Click"/>
                    <Button Content="Export history CSV" Click="ExportHistory_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="4" Padding="16" Background="#181B21" CornerRadius="10">
            <StackPanel>
                <TextBlock Text="UPDATES" FontSize="11" FontWeight="Bold" Foreground="#9EA6B2"/>
                <TextBlock Text="Checks the official GitHub releases for this open-source launcher."
                           Margin="0,5,0,12" Foreground="#D9DEE5"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Check for updates" Margin="0,0,8,0" Click="CheckUpdates_Click"/>
                    <Button x:Name="InstallUpdateButton"
                            Content="Download &amp; install"
                            IsEnabled="False"
                            Click="InstallUpdate_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock x:Name="StatusText" Grid.Row="5" Margin="0,16,0,0"
                   Foreground="#9EA6B2" TextWrapping="Wrap"/>
    </Grid>
</Window>
